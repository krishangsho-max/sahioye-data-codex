  {
   "id": "ssc-steno-2026.age-relaxation",
   "kind": "age",
   "label": { "en": "Age relaxation", "hi": "आयु छूट" },
   "value": { "en": "SC/ST 5 years, OBC 3 years. PwBD: UR/EWS 10, OBC 13, SC/ST 15 years. Ex-servicemen 3 years after military service. Defence personnel disabled in specified operations: 3 years, or 8 years for SC/ST.", "hi": "SC/ST 5 वर्ष, OBC 3 वर्ष। दिव्यांग: UR/EWS 10, OBC 13, SC/ST 15 वर्ष। पूर्व सैनिक सैन्य सेवा घटाकर 3 वर्ष। निर्दिष्ट अभियानों में अक्षम रक्षा कर्मी: 3 वर्ष, SC/ST के लिए 8 वर्ष।" },
   "verified": true,
   "source": "N1"
  },
  {
   "id": "ssc-steno-2026.age-relaxation-group-c-posts-only",
   "kind": "age",
   "label": { "en": "Age relaxation, Group C posts only", "hi": "आयु छूट, केवल समूह ग पद" },
   "value": { "en": "Central Government civilian employees with 3 years of regular continuous service: up to 40 years (45 for SC/ST). Widowed, divorced or judicially separated women who have not remarried: up to 35 years (40 for SC/ST). Conditions are in the notification.", "hi": "3 वर्ष की नियमित निरंतर सेवा वाले केंद्र सरकार के असैन्य कर्मचारी: 40 वर्ष तक (SC/ST के लिए 45)। विधवा, तलाकशुदा या न्यायिक रूप से अलग हुई महिलाएँ जिन्होंने पुनर्विवाह नहीं किया: 35 वर्ष तक (SC/ST के लिए 40)। शर्तें अधिसूचना में हैं।" },
   "verified": true,
   "source": "N1"
  },
  {
   "id": "ssc-steno-2026.qualification",
   "kind": "qualification",
   "label": { "en": "Qualification", "hi": "योग्यता" },
   "value": { "en": "Class 12 or equivalent from a recognised board or university on or before 1 Aug 2026, and skill in stenography. User departments verify documents after the final result.", "hi": "1 अगस्त 2026 या उससे पहले मान्यता प्राप्त बोर्ड या विश्वविद्यालय से 12वीं या समकक्ष, और आशुलिपि में कौशल। अंतिम परिणाम के बाद विभाग दस्तावेज़ जाँचते हैं।" },
   "short": { "en": "12th pass, with stenography skill", "hi": "12वीं पास, आशुलिपि कौशल के साथ" },
   "shortLabel": { "en": "Qualification", "hi": "योग्यता" },
   "verified": true,
   "source": "N1"
  },
  {
   "id": "ssc-steno-2026.qualification-matriculate-ex-servicemen",
   "kind": "qualification",
   "label": { "en": "Qualification, matriculate ex-servicemen", "hi": "योग्यता, मैट्रिक पास पूर्व सैनिक" },
   "value": { "en": "A matriculate ex-serviceman with at least 15 years of service by the closing date can apply for reserved Grade D ESM posts. The notice's next sentence on completing 15 years within one year of closing is unclear; ask SSC before relying on it.", "hi": "आवेदन की अंतिम तिथि तक कम से कम 15 वर्ष की सेवा वाला मैट्रिक पास पूर्व सैनिक आरक्षित श्रेणी घ पूर्व सैनिक पदों के लिए आवेदन कर सकता है। अधिसूचना में अंतिम तिथि के एक वर्ष के भीतर 15 वर्ष पूरे करने वाला वाक्य स्पष्ट नहीं है; भरोसा करने से पहले SSC से पूछें।" },
   "verified": false,
   "source": "N1"
  },
  {
   "id": "ssc-steno-2026.nationality",
   "kind": "other",
   "label": { "en": "Nationality", "hi": "राष्ट्रीयता" },
   "value": { "en": "Indian citizen, or a subject of Nepal or Bhutan, or a person of Indian origin who migrated from Pakistan, Myanmar, Sri Lanka, Kenya, Uganda, Tanzania, Zambia, Malawi, Zaire, Ethiopia or Vietnam to settle in India. All except Indian citizens need an eligibility certificate from the Government of India.", "hi": "भारतीय नागरिक, या नेपाल या भूटान का नागरिक, या पाकिस्तान, म्यांमार, श्रीलंका, केन्या, युगांडा, तंज़ानिया, ज़ाम्बिया, मलावी, ज़ायरे, इथियोपिया या वियतनाम से भारत में बसने आया भारतीय मूल का व्यक्ति। भारतीय नागरिकों के अलावा सभी को भारत सरकार का पात्रता प्रमाणपत्र चाहिए।" },
   "verified": true,
   "source": "N1"
  },
  {
   "id": "ssc-steno-2026.fee",
   "kind": "fee",
   "label": { "en": "Fee", "hi": "शुल्क" },
   "value": { "en": "₹100, paid online. No fee for women, SC, ST, PwBD and ex-servicemen eligible for reservation. Ex-servicemen posts are only in Grade D (Group C), not Grade C (Group B).", "hi": "₹100, ऑनलाइन। महिलाओं, SC, ST, दिव्यांग और आरक्षण के पात्र पूर्व सैनिकों के लिए शुल्क नहीं। पूर्व सैनिकों के पद केवल श्रेणी घ (समूह ग) में हैं, श्रेणी ग (समूह ख) में नहीं।" },
   "short": "₹100",
   "shortLabel": { "en": "Fee", "hi": "शुल्क" },
   "verified": true,
   "source": "N1"
  },
  {
   "id": "ssc-steno-2026.border-roads-organisation-posts",
